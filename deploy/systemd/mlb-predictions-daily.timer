[Unit]
Description=Refresh MLB predictions before common first-pitch windows

[Timer]
OnCalendar=*-*-* 07:30:00 America/Los_Angeles
OnCalendar=*-*-* 10:30:00 America/Los_Angeles
OnCalendar=*-*-* 13:30:00 America/Los_Angeles
OnCalendar=*-*-* 16:00:00 America/Los_Angeles
OnCalendar=*-*-* 18:00:00 America/Los_Angeles
Persistent=true
AccuracySec=1min
Unit=mlb-predictions-daily.service

[Install]
WantedBy=timers.target
